{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      ".read": false,
      ".write": false,

      "$code": {
        ".read": "$code.length == 4",
        ".write": "$code.length == 4",
        ".validate": "!newData.exists() || newData.hasChildren(['code', 'hostId', 'status'])",

        "code":        { ".validate": "newData.isString() && newData.val() == $code" },
        "hostId":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdAt":   { ".validate": "newData.isNumber()" },
        "round":       { ".validate": "newData.isNumber()" },
        "duration":    { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 120" },
        "timerEndsAt": { ".validate": "newData.isNumber()" },
        "game":        { ".validate": "newData.isString() && newData.val().length <= 20" },
        "location":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "status":      { ".validate": "newData.val() == 'lobby' || newData.val() == 'playing'" },

        "players": {
          "$playerId": {
            ".validate": "!newData.exists() || newData.hasChildren(['id', 'name'])",
            "id":       { ".validate": "newData.isString() && newData.val() == $playerId" },
            "name":     { ".validate": "newData.isString() && newData.val().length <= 14" },
            "avatar":   { ".validate": "newData.isNumber()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "role":     { ".validate": "newData.isString() && newData.val().length <= 20" },
            "spy":      { ".validate": "newData.isBoolean()" },
            "place":    { ".validate": "newData.isString() && newData.val().length <= 40" },
            "job":      { ".validate": "newData.isString() && newData.val().length <= 40" }
          }
        }
      }
    }
  }
}
