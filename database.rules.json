{
  "rules": {
    "rooms": {
      ".read": false,
      ".write": false,
      "$code": {
        ".read": "$code.length == 4",
        ".write": "$code.length == 4",
        ".validate": "newData.hasChildren(['code', 'hostId', 'status']) || !newData.exists()",
        "code":      { ".validate": "newData.isString() && newData.val() == $code" },
        "hostId":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "round":     { ".validate": "newData.isNumber()" },
        "status":    { ".validate": "newData.val() == 'lobby' || newData.val() == 'playing'" },
        "players": {
          "$playerId": {
            ".validate": "!newData.exists() || newData.hasChildren(['id', 'name'])",
            "id":       { ".validate": "newData.isString() && newData.val() == $playerId" },
            "name":     { ".validate": "newData.isString() && newData.val().length <= 14" },
            "avatar":   { ".validate": "newData.isNumber()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "role":     { ".validate": "newData.val() == 'mafia' || newData.val() == 'doctor' || newData.val() == 'detective' || newData.val() == 'villager'" },
            "$other":   { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
